  "task_description": "{'component_name': 'Main Container for TyreSense', 'description': 'Primary container for TyreSense implementation: TyreWise is a visually engaging, scroll-interactive ReactJS web app for tyre recommendation and monitoring. It features animated tyre intros, scroll-based transitions, car detail input with car image, location and weather-based tyre suggestions, filtering, store locator, user data storage, reminders, and a polished, minimal dark-themed UI. Integrates with Geolocation, OpenWeatherMap, Google Maps, Firebase/Supabase, and EmailJS APIs. Designed for both mobile and desktop, with smooth animations and a clean, bold aesthetic.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Animated Tyre Intro",\n      "description": "On app load, a small tyre animates (rolls/zooms) across the screen as an engaging introduction.",\n      "isEnabled": true\n    },\n    {\n      "name": "Scroll-based Tyre Animations",\n      "description": "Tyres rotate or animate as the user scrolls, using Framer Motion or similar for smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Car Details Input with Image",\n      "description": "User enters car make, model, and year; app fetches and displays a small image/model of the car.",\n      "isEnabled": true\n    },\n    {\n      "name": "Location & Weather-based Tyre Recommendation",\n      "description": "Uses Geolocation and OpenWeatherMap APIs to recommend suitable tyres (e.g., snow, summer) based on user\'s location and weather.",\n      "isEnabled": true\n    },\n    {\n      "name": "Tyre Filtering",\n      "description": "Users can filter recommended tyres by brand, size, and budget for personalized results.",\n      "isEnabled": true\n    },\n    {\n      "name": "Nearby Tyre Store Locator",\n      "description": "Integrates Google Maps API to show nearby tyre stores based on user location.",\n      "isEnabled": true\n    },\n    {\n      "name": "User Tyre Data Storage & Age Notification",\n      "description": "Stores user\'s car and tyre data in Firebase/Supabase; notifies when tyres are too old.",\n      "isEnabled": true\n    },\n    {\n      "name": "Scroll Animations for Recommendations",\n      "description": "Tyres spin and animate as user scrolls through recommendations for an interactive experience.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dark Mode with Neon Accents",\n      "description": "UI uses a dark grey background with neon yellow highlights for key elements, ensuring a modern look.",\n      "isEnabled": true\n    },\n    {\n      "name": "Buy Now Button",\n      "description": "Each tyre recommendation includes a \'Buy Now\' button linking to the official brand website in a new tab.",\n      "isEnabled": true\n    },\n    {\n      "name": "Minimal, Clean Design",\n      "description": "Apple.com/RichardMille.com-inspired design with bold fonts, white space, and minimal clutter.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive Design",\n      "description": "Fully responsive layout for both mobile and desktop devices.",\n      "isEnabled": true\n    },\n    {\n      "name": "Tyre Replacement Reminders",\n      "description": "Sends reminder messages (via EmailJS or popup) when tyres are due for replacement.",\n      "isEnabled": true\n    },\n    {\n      "name": "User Preferences Persistence",\n      "description": "Saves user preferences in LocalStorage or Firebase for session reloads.",\n      "isEnabled": true\n    },\n    {\n      "name": "Smooth Loading Screen",\n      "description": "Displays a smooth loading animation before tyre recommendations appear.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#4e5355